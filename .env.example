# OrderFlowKawa Environment Variables

# Optional: Path to the specific MetaTrader 5 terminal executable you wish to run.
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of Telegram User IDs allowed to control the bot
TELEGRAM_ADMIN_IDS=your_telegram_user_id_here

# Target Trading Symbol (e.g. USTEC, NAS100, NQ)
MT5_SYMBOL=USTEC

# MT5 Login Details
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Server